# UTF-8 charset in HTTP headers (in addition to <meta charset> in HTML)
AddDefaultCharset UTF-8

# Custom "page not found" page (also used for the hidden build paths below)
ErrorDocument 404 /404.html

# Canonical URL: https://udaan.org.np
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1) www → non-www (301 permanent)
RewriteCond %{HTTP_HOST} ^www\.udaan\.org\.np$ [NC]
RewriteRule ^ https://udaan.org.np%{REQUEST_URI} [R=301,L]

# 2) HTTP → HTTPS on apex (301 permanent)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^udaan\.org\.np$ [NC]
RewriteRule ^ https://udaan.org.np%{REQUEST_URI} [R=301,L]

# 3) Hide build/source files that are not part of the website (404)
#    .well-known stays reachable for SSL certificate checks.
RewriteRule (^|/)\.(?!well-known(/|$)) - [R=404,L]
RewriteRule ^(package(-lock)?\.json|tailwind\.config\.js|css/tailwind-src\.css)$ - [R=404,L]
RewriteRule \.(md|sh|py|yml|yaml|lock)$ - [R=404,L]
</IfModule>

# Hide build/source folders (404). mod_alias, so it also applies inside
# folders that carry their own .htaccess (e.g. an old dist/ upload).
<IfModule mod_alias.c>
RedirectMatch 404 ^/(dist|design-system|scripts|node_modules|data|\.git|\.github)(/|$)
</IfModule>

# ---------------------------------------------------------------------------
# Browser caching
# CSS/JS links get ?v=<commit> added at deploy time (see deploy-cpanel.yml),
# so they can be cached for a year and still update on every deploy.
# Images are cached for a year too: when replacing an image, use a NEW
# file name so visitors get the new version.
# HTML is always revalidated so new content appears immediately.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 week"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType application/xml "access plus 1 hour"
ExpiresByType text/xml "access plus 1 hour"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(css|js|webp|png|jpe?g|svg|ico|woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Security headers
# - HSTS: browsers use HTTPS only for udaan.org.np for 1 year (subdomains
#   such as member.udaan.org.np are not affected).
# - nosniff: browsers trust the declared file type (all types are correct).
# - SAMEORIGIN / frame-ancestors: other sites cannot embed udaan.org.np in a
#   frame (clickjacking protection).
# - Referrer-Policy: other sites see only "udaan.org.np", not the full page URL.
# - Permissions-Policy: the site never uses camera, microphone, location or
#   payment APIs, so they are switched off.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Content-Security-Policy "frame-ancestors 'self'"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
Header always unset X-Powered-By
</IfModule>
